---
/**
 * ITERATION 07 — EL CONCIERGE DE LA MUCCA
 * A compact floating panel, not a takeover — deliberately smaller than a
 * typical chat widget so the site stays visible behind it. The "brain" is a
 * small keyword-matched state machine, not a real model; it never fakes a
 * long "thinking" delay, and every recommendation is drawn from the same
 * verified `restaurants` collection the rest of the site uses (moods,
 * occasions, features — never an invented per-venue claim).
 *
 * Context-sharing with «Encuentra tu Mucca» (Ch05Descubre.astro): both
 * components read/write the same sessionStorage key so the concierge never
 * re-asks something the wizard already answered this visit.
 */
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const venues = (await getCollection('restaurants')).sort((a, b) => a.data.order - b.data.order);

const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/casas/*.jpg', {
  eager: true,
});

const heroPorSlug = Object.fromEntries(
  await Promise.all(
    venues.map(async (v) => {
      const foto = fotos[`../assets/casas/${v.data.slug}.jpg`]?.default;
      if (!foto) return [v.data.slug, null];
      const [avif, webp, jpg] = await Promise.all([
        getImage({ src: foto, width: 560, format: 'avif' }),
        getImage({ src: foto, width: 560, format: 'webp' }),
        getImage({ src: foto, width: 560, format: 'jpeg' }),
      ]);
      return [v.data.slug, { avif: avif.src, webp: webp.src, jpg: jpg.src }];
    })
  )
);

// Pre-compute data for the mock AI — every field traces to the verified content model.
const aiVenues = venues.map((v) => ({
  slug: v.data.slug,
  name: v.data.name,
  tagline: v.data.tagline,
  neighborhood: v.data.neighborhood,
  bookingUrl: v.data.bookingUrl || null,
  phone: v.data.phone || null,
  moods: v.data.moods || [],
  occasions: v.data.occasions || [],
  times: v.data.times || [],
  groups: v.data.groups || [],
  zone: v.data.zone || null,
  features: v.data.features || [],
  accent: v.data.accent || 'tomato',
  hero: heroPorSlug[v.data.slug],
}));

const base = import.meta.env.BASE_URL;
---

<!-- The Floating Action Button -->
<button class="concierge-fab" id="concierge-trigger" aria-label="Hablar con el Concierge de la Mucca" aria-expanded="false">
  <span class="fab-icon">✨</span>
  <span class="fab-text">Concierge</span>
</button>

<!-- The Concierge Panel — a floating widget, not a full-screen overlay -->
<div id="concierge-overlay" class="concierge-overlay" aria-hidden="true" hidden>
  <aside class="concierge-panel" role="dialog" aria-label="El Concierge de la Mucca">
    <header class="concierge-header">
      <div class="concierge-identity">
        <h2 class="concierge-title">El Concierge de la Mucca</h2>
        <p class="concierge-status">
          <span class="status-dot"></span> En línea
        </p>
      </div>
      <button class="btn-close" id="concierge-close" aria-label="Cerrar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </header>

    <div class="concierge-chat" id="concierge-chat" aria-live="polite">
      <!-- Welcome message -->
      <div class="msg msg--ai">
        <div class="msg-bubble msg-bubble--entry">
          <p class="msg-entry__kicker">¿No sabes dónde ir?</p>
          <p>Te ayudamos.</p>
        </div>
      </div>
      <div class="msg-quick-replies" id="initial-replies">
        <button class="quick-reply">Quiero cenar con amigos</button>
        <button class="quick-reply">Busco un sitio para una cita</button>
        <button class="quick-reply">Estoy de visita en Madrid</button>
        <button class="quick-reply">¿Qué me recomiendas?</button>
        <button class="quick-reply">Quiero comer pizza</button>
      </div>
    </div>

    <!-- Loading Indicator -->
    <div class="concierge-typing" id="concierge-typing" hidden>
      <span class="dot"></span><span class="dot"></span><span class="dot"></span>
    </div>

    <form class="concierge-input-area" id="concierge-form">
      <input
        type="text"
        id="concierge-input"
        placeholder="Escribe aquí tu plan..."
        autocomplete="off"
        required
      />
      <button type="submit" class="btn-send" aria-label="Enviar">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/>
        </svg>
      </button>
    </form>
  </aside>

  <script is:inline define:vars={{ aiVenues, baseUrl: base }}>
    window.lamuccaAIVenues = aiVenues;
    window.lamuccaAIBase = baseUrl;
  </script>
</div>

<style>
  @keyframes fab-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-6px); }
  }

  /* --- FAB --- */
  .concierge-fab {
    position: fixed;
    bottom: var(--space-l);
    right: var(--space-l);
    z-index: var(--z-sticky);
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    padding: 0.8rem 1.2rem;
    border: var(--rule-width) solid var(--ink);
    border-radius: var(--radius-pill);
    background: var(--text-primary);
    color: var(--surface-page);
    font-family: var(--font-text);
    font-size: var(--step-0);
    box-shadow: var(--shadow-print);
    cursor: pointer;
    transition: transform var(--t-micro) var(--ease-out), box-shadow var(--t-micro) var(--ease-out);
    animation: fab-float 4s ease-in-out infinite;
  }

  .concierge-fab:hover {
    animation-play-state: paused;
    transform: translateY(-4px);
    box-shadow: 0 16px 0 -6px var(--ink);
  }

  .fab-icon {
    font-size: 1.2em;
  }

  @media (max-width: 899px) {
    .concierge-fab {
      /* Above the reserve bar, never on top of the CTA */
      bottom: calc(var(--reserve-bar-height) + env(safe-area-inset-bottom) + var(--space-s));
      right: var(--gutter);
      left: auto;
      z-index: calc(var(--z-nav) - 2);
      padding: 0.65rem 1rem;
      font-size: var(--step--1);
      min-height: 44px;
    }

    .fab-text {
      display: none;
    }
  }

  /* --- The panel: a floating widget, never a takeover ------------------ */
  .concierge-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--z-sheet);
    pointer-events: none; /* the rest of the site stays clickable behind it */
  }

  .concierge-overlay[hidden] {
    display: none !important;
  }

  .concierge-panel {
    pointer-events: auto;
    position: fixed;
    right: var(--space-l);
    bottom: calc(var(--space-l) + 4.75rem);
    width: min(23rem, calc(100vw - 2 * var(--space-l)));
    max-height: min(38rem, calc(100vh - 8rem));
    display: flex;
    flex-direction: column;
    background: color-mix(in srgb, var(--surface-page) 92%, transparent);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border: var(--rule);
    border-radius: 20px;
    box-shadow: 0 24px 48px -12px rgb(32 27 22 / 0.28);
    opacity: 0;
    transform: translateY(16px) scale(0.96);
  }

  @media (max-width: 899px) {
    .concierge-panel {
      left: var(--space-s);
      right: var(--space-s);
      bottom: calc(var(--reserve-bar-height) + env(safe-area-inset-bottom) + var(--space-s) + 3.75rem);
      width: auto;
      max-height: min(66vh, 34rem);
      /* The hero photo underneath is busier here than on desktop — a touch
         more opaque keeps chat text legible without losing the glass feel. */
      background: color-mix(in srgb, var(--surface-page) 97%, transparent);
    }
  }

  /* --- Header --- */
  .concierge-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-s);
    padding: var(--space-m) var(--space-l);
    border-bottom: var(--rule);
    flex: none;
  }

  .concierge-title {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-display);
    line-height: 1.15;
  }

  .concierge-status {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    font-size: var(--step--1);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--olive);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.8); }
    100% { opacity: 1; transform: scale(1); }
  }

  .btn-close {
    flex: none;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-primary);
    padding: 8px;
    margin: -8px;
    min-width: 40px;
    min-height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--t-micro) var(--ease-out);
  }

  .btn-close:hover {
    transform: rotate(90deg);
  }

  /* --- Chat area --- */
  .concierge-chat {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    scroll-behavior: smooth;
  }

  /* The chat log is built at runtime via insertAdjacentHTML (see the
     <script> below), so none of these elements carry Astro's scoping
     attribute — every selector below that can target a message, card or
     quick-reply has to be :global() or it silently never matches. */
  :global(.msg) {
    display: flex;
    flex-direction: column;
    max-width: 92%;
    opacity: 0;
    transform: translateY(10px);
    animation: msg-in var(--t-enter) var(--ease-out) both;
  }

  @keyframes msg-in {
    to { opacity: 1; transform: none; }
  }

  :global(.msg--ai) {
    align-self: flex-start;
  }

  :global(.msg--user) {
    align-self: flex-end;
  }

  :global(.msg-bubble) {
    padding: 0.85rem 1.1rem;
    border-radius: 1.1rem;
    font-size: var(--step--1);
    line-height: 1.5;
    text-wrap: pretty;
  }

  :global(.msg--ai .msg-bubble) {
    background: var(--surface-raised);
    color: var(--text-primary);
    border-bottom-left-radius: 0.3rem;
  }

  :global(.msg--user .msg-bubble) {
    background: var(--text-accent);
    color: var(--surface-page);
    border-bottom-right-radius: 0.3rem;
  }

  .msg-bubble--entry {
    display: grid;
    gap: 2px;
  }

  .msg-entry__kicker {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: var(--weight-display);
    line-height: 1.2;
  }

  /* --- Rich card inside chat: image → name → reason → CTAs --- */
  :global(.msg-card) {
    margin-top: 4px;
    border: var(--rule);
    border-radius: var(--radius-card);
    background: var(--surface-page);
    overflow: hidden;
    width: 100%;
    min-width: 15rem;
  }

  :global(.msg-card__image) {
    display: block;
    position: relative;
    --campo-ratio: 16 / 10;
    text-decoration: none;
  }

  :global(.msg-card__image picture),
  :global(.msg-card__image img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  :global(.msg-card__image img) {
    object-fit: cover;
    filter: none;
  }

  :global(.msg-card__body) {
    padding: var(--space-s) var(--space-m);
  }

  :global(.msg-card__title) {
    font-family: var(--font-display);
    font-size: var(--step-0);
    font-weight: 560;
  }

  :global(.msg-card__meta) {
    font-size: var(--step--1);
    color: var(--text-tertiary);
    margin-top: 2px;
  }

  :global(.msg-card__reason) {
    margin-top: var(--space-2xs);
    font-size: var(--step--1);
    color: var(--text-secondary);
    line-height: 1.45;
  }

  :global(.msg-card__actions) {
    display: flex;
    gap: 8px;
    padding: 0 var(--space-m) var(--space-m);
  }

  :global(.msg-card .btn) {
    flex: 1;
    text-align: center;
    padding: 0.6em 0.4em;
    min-height: 40px;
    font-size: var(--step--2);
  }

  /* A single follow-up reservation nudge, lighter than a full card */
  :global(.msg-reserve) {
    margin-top: 4px;
  }

  /* --- Quick replies --- */
  :global(.msg-quick-replies) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 2px;
  }

  :global(.quick-reply) {
    background: transparent;
    border: var(--rule-width) solid var(--text-primary);
    color: var(--text-primary);
    padding: 0.4em 0.9em;
    min-height: 40px;
    border-radius: var(--radius-pill);
    font-family: var(--font-text);
    font-size: var(--step--2);
    cursor: pointer;
    transition: background var(--t-micro) var(--ease-out), color var(--t-micro) var(--ease-out);
  }

  :global(.quick-reply:hover) {
    background: var(--text-primary);
    color: var(--surface-page);
  }

  /* --- Typing indicator: minimal, brief --- */
  .concierge-typing {
    padding: 0 var(--space-m) var(--space-xs);
    display: flex;
    gap: 4px;
    align-items: center;
  }

  .concierge-typing .dot {
    width: 5px;
    height: 5px;
    background: var(--text-tertiary);
    border-radius: 50%;
    animation: typing 1.2s infinite both;
  }

  .concierge-typing .dot:nth-child(1) { animation-delay: 0s; }
  .concierge-typing .dot:nth-child(2) { animation-delay: 0.15s; }
  .concierge-typing .dot:nth-child(3) { animation-delay: 0.3s; }

  @keyframes typing {
    0%, 80%, 100% { transform: scale(0); opacity: 0.5; }
    40% { transform: scale(1); opacity: 1; }
  }

  /* --- Input area --- */
  .concierge-input-area {
    flex: none;
    display: flex;
    gap: var(--space-xs);
    padding: var(--space-s) var(--space-m);
    border-top: var(--rule);
  }

  #concierge-input {
    flex: 1;
    min-width: 0;
    background: var(--surface-page);
    border: var(--rule);
    border-radius: var(--radius-pill);
    padding: 0.65rem 1rem;
    font-family: var(--font-text);
    font-size: var(--step--1);
    color: var(--text-primary);
    outline: none;
    transition: border-color var(--t-micro) var(--ease-out);
  }

  #concierge-input:focus {
    border-color: var(--text-accent);
  }

  .btn-send {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: none;
    border-radius: 50%;
    background: var(--text-primary);
    color: var(--surface-page);
    cursor: pointer;
    transition: transform var(--t-micro) var(--ease-out);
  }

  .btn-send:hover {
    transform: scale(1.05);
  }

  @media (prefers-reduced-motion: reduce) {
    .concierge-fab {
      animation: none;
    }

    .status-dot,
    .concierge-typing .dot {
      animation: none;
      opacity: 1;
      transform: none;
    }

    :global(.msg) {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  const CONTEXT_KEY = 'lamucca:context';

  function readSharedContext() {
    try {
      const raw = sessionStorage.getItem(CONTEXT_KEY);
      if (!raw) return {};
      const parsed = JSON.parse(raw);
      return parsed && typeof parsed === 'object' ? parsed : {};
    } catch {
      return {};
    }
  }

  const OCCASION_PHRASE: Record<string, string> = {
    amigos: 'para ir con amigos',
    cita: 'para una cita',
    familia: 'para un plan en familia',
    trabajo: 'para una comida de trabajo',
    solo: 'para ti solo',
  };

  const MOOD_PHRASE: Record<string, string> = {
    animado: 'con ambiente animado',
    tranquilo: 'tranquilo, para hablar bien',
  };

  class ConciergeBrain {
    memory: Record<string, any>;
    state: string;

    constructor() {
      this.state = 'idle';
      // Whatever «Encuentra tu Mucca» already knows this visit — never re-asked.
      const shared = readSharedContext();
      this.memory = {
        quien: shared.quien ?? null,
        mood: shared.plan === 'animado' ? 'animado' : shared.plan?.startsWith('tranquil') ? 'tranquilo' : null,
        zona: shared.barrio ?? null,
        lastRecommended: null,
      };
    }

    hasContext() {
      return Boolean(this.memory.quien || this.memory.mood || this.memory.zona);
    }

    pool(venues: any[]) {
      const { quien, mood, zona } = this.memory;
      let matches = venues;
      if (quien && quien !== 'solo') {
        const byQuien = matches.filter((v) => v.occasions.includes(quien === 'cita' ? 'pareja' : quien));
        if (byQuien.length) matches = byQuien;
      } else if (quien === 'solo') {
        const bySolo = matches.filter((v) => v.groups.includes('solo'));
        if (bySolo.length) matches = bySolo;
      }
      if (mood) {
        const byMood = matches.filter((v) => v.moods.includes(mood));
        if (byMood.length) matches = byMood;
      }
      if (zona) {
        const byZona = matches.filter((v) => v.zone === zona);
        if (byZona.length) matches = byZona;
      }
      return matches.length ? matches : venues;
    }

    pick(venues: any[]) {
      const pool = this.pool(venues);
      return pool[Math.floor(Math.random() * pool.length)];
    }

    reasonFor(venue: any) {
      const bits: string[] = [];
      if (this.memory.quien) bits.push(OCCASION_PHRASE[this.memory.quien] ?? '');
      if (this.memory.mood) bits.push(MOOD_PHRASE[this.memory.mood] ?? '');
      const context = bits.filter(Boolean).join(', ');
      const place = `En ${venue.neighborhood}.`;
      return context ? `${place} Justo lo que buscabas: ${context}.` : `${place} ${venue.tagline}.`;
    }

    recommend(venue: any, text: string, reason?: string) {
      this.memory.lastRecommended = venue.slug;
      return { text, card: venue, reason: reason ?? this.reasonFor(venue) };
    }

    async process(message: string) {
      const msg = message.toLowerCase();
      // A short, real pause for the UI to breathe — never a fake "thinking" delay.
      await new Promise((r) => setTimeout(r, 260 + Math.random() * 140));

      const venues = (window as any).lamuccaAIVenues || [];

      // Pizza — real, verified: it's on every casa's carta, and it was born at Lamucca de Pez.
      if (msg.includes('pizza')) {
        const origin = venues.find((v: any) => v.slug === 'lamucca-de-pez') ?? venues[0];
        return this.recommend(
          origin,
          'La de boletus, claro. Nació aquí:',
          'Se sirve en las dieciocho casas — pero esta es donde nació, el 1 de mayo de 2008.'
        );
      }

      // Visiting Madrid
      if (msg.includes('visita') || msg.includes('turis') || msg.includes('estoy en madrid')) {
        const castizos = venues.filter((v: any) => v.moods.includes('castizo'));
        const pick = castizos[Math.floor(Math.random() * castizos.length)] ?? venues[0];
        return this.recommend(
          pick,
          'Para conocer Madrid de verdad, esta:',
          `Ambiente castizo en ${pick.neighborhood} — nada de postureo turístico.`
        );
      }

      // Friends
      if (msg.includes('amig') || msg.includes('grupo')) {
        this.memory.quien = 'amigos';
        if (this.memory.mood) {
          return this.recommend(
            this.pick(venues),
            this.memory.mood === 'animado' ? 'Marchando, algo animado:' : 'Va, para hablar tranquilos:'
          );
        }
        this.state = 'awaiting_mood';
        return {
          text: '¡Buen plan! ¿Algo animado y con música, o mejor tranquilo para hablar?',
          replies: ['Animado', 'Tranquilo'],
        };
      }

      if (this.state === 'awaiting_mood' && (msg.includes('animad') || msg.includes('música') || msg.includes('musica'))) {
        this.state = 'idle';
        this.memory.mood = 'animado';
        return this.recommend(this.pick(venues), 'Marchando, algo animado:');
      }
      if (this.state === 'awaiting_mood' && msg.includes('tranquil')) {
        this.state = 'idle';
        this.memory.mood = 'tranquilo';
        return this.recommend(this.pick(venues), 'Va, para hablar tranquilos:');
      }

      // Date night
      if (msg.includes('parej') || msg.includes('cita') || msg.includes('novi')) {
        this.memory.quien = 'cita';
        return this.recommend(
          this.pick(venues),
          'Para una cita cuidamos la atmósfera. Esta es la mía:'
        );
      }

      // "¿Qué me recomiendas?" — use context if we already have it
      if (msg.includes('recomiendas') || msg.includes('recomendacion') || msg.includes('recomendación')) {
        if (this.hasContext()) {
          return this.recommend(this.pick(venues), 'Con lo que ya me contaste, esta es la mía:');
        }
        return {
          text: '¿Con quién vas — amigos, en pareja, o solo?',
          replies: ['Con amigos', 'En pareja', 'Voy solo'],
        };
      }
      if (msg === 'voy solo') {
        this.memory.quien = 'solo';
        return this.recommend(this.pick(venues), 'Toma nota:');
      }

      // Hours
      if (msg.includes('horario') || msg.includes('hora ') || msg.includes('abierto')) {
        return {
          text: 'No cerramos: cocina abierta todo el día. ¿Para qué casa te miro mesa?',
          replies: ['Lamucca de Pez', 'La Pescadería', 'En Bruto'],
        };
      }

      // Ready to book — reuse the last recommendation if there is one
      if (msg.includes('reservar') || msg.includes('mesa')) {
        if (this.memory.lastRecommended) {
          const venue = venues.find((v: any) => v.slug === this.memory.lastRecommended);
          if (venue) return { text: 'Te lo dejo listo:', reserveVenue: venue };
        }
        return {
          text: '¿Para qué casa? Dime el plan y te digo dónde.',
          replies: ['Con amigos', 'En pareja', 'De visita'],
        };
      }

      // Fallback
      return {
        text: 'Cuéntame el plan y te digo dónde ir.',
        replies: ['Con amigos', 'En pareja', 'De visita'],
      };
    }
  }

  // Module-scope: re-evaluated fresh on every real page load (this site uses
  // full navigations + the browser's native View Transitions, not Astro's
  // client router), so shared context is always read fresh here too.
  const brain = new ConciergeBrain();

  function initConcierge() {
    const overlay = document.getElementById('concierge-overlay');
    if (!overlay || overlay.dataset.init) return;
    overlay.dataset.init = 'true';

    const trigger = document.getElementById('concierge-trigger')!;
    const panel = document.querySelector<HTMLElement>('.concierge-panel')!;
    const closeBtn = document.getElementById('concierge-close')!;
    const chatBox = document.getElementById('concierge-chat')!;
    const form = document.getElementById('concierge-form') as HTMLFormElement;
    const input = document.getElementById('concierge-input') as HTMLInputElement;
    const typingIndicator = document.getElementById('concierge-typing')!;
    const base = (window as any).lamuccaAIBase ?? '/';

    let isOpen = false;

    function reducedMotion() {
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    }

    function openConcierge() {
      if (isOpen) return;
      isOpen = true;
      overlay!.hidden = false;
      overlay!.setAttribute('aria-hidden', 'false');
      trigger.setAttribute('aria-expanded', 'true');

      if (reducedMotion()) {
        gsap.set(panel, { opacity: 1, y: 0, scale: 1 });
      } else {
        gsap.fromTo(
          panel,
          { opacity: 0, y: 16, scale: 0.96 },
          { opacity: 1, y: 0, scale: 1, duration: 0.32, ease: 'power2.out' }
        );
      }

      setTimeout(() => input.focus(), reducedMotion() ? 0 : 320);
    }

    function closeConcierge() {
      if (!isOpen) return;
      isOpen = false;

      trigger.focus();
      trigger.setAttribute('aria-expanded', 'false');
      overlay!.setAttribute('aria-hidden', 'true');

      if (reducedMotion()) {
        overlay!.hidden = true;
        return;
      }
      gsap.to(panel, {
        opacity: 0,
        y: 16,
        scale: 0.96,
        duration: 0.24,
        ease: 'power2.in',
        onComplete: () => {
          overlay!.hidden = true;
        },
      });
    }

    trigger.addEventListener('click', openConcierge);
    closeBtn.addEventListener('click', closeConcierge);

    // A floating panel, not a modal: clicking anywhere outside it just closes it.
    document.addEventListener('click', (event) => {
      if (!isOpen) return;
      const target = event.target as Node;
      if (panel.contains(target) || trigger.contains(target)) return;
      closeConcierge();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen) closeConcierge();
    });

    // --- UI renderers ---
    function appendUserMessage(text: string) {
      const html = `
        <div class="msg msg--user">
          <div class="msg-bubble">${text}</div>
        </div>
      `;
      chatBox.insertAdjacentHTML('beforeend', html);
      scrollToBottom();
    }

    function reserveMarkup(v: any) {
      return v.bookingUrl
        ? { href: v.bookingUrl, target: '_blank', rel: 'noopener' }
        : v.phone
          ? { href: `tel:+34${v.phone}` }
          : { href: `${base}restaurantes/${v.slug}/` };
    }

    function appendAIMessage(response: any) {
      const formattedText = (response.text || '').replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

      let html = `
        <div class="msg msg--ai">
          <div class="msg-bubble">${formattedText}</div>
        </div>
      `;

      if (response.card) {
        const v = response.card;
        const rsv = reserveMarkup(v);
        html += `
          <div class="msg msg--ai">
            <div class="msg-card" data-venue>
              <a class="msg-card__image campo campo--${v.accent}" href="${base}restaurantes/${v.slug}/">
                ${
                  v.hero
                    ? `<picture>
                  <source type="image/avif" srcset="${v.hero.avif}" />
                  <source type="image/webp" srcset="${v.hero.webp}" />
                  <img src="${v.hero.jpg}" alt="Interior de ${v.name}" loading="lazy" decoding="async" />
                </picture>`
                    : ''
                }
              </a>
              <div class="msg-card__body">
                <div class="msg-card__title">${v.name}</div>
                <div class="msg-card__meta">${v.neighborhood} · ${v.tagline}</div>
                ${response.reason ? `<p class="msg-card__reason">${response.reason}</p>` : ''}
              </div>
              <div class="msg-card__actions">
                <a href="${base}restaurantes/${v.slug}/" class="btn">Ver restaurante</a>
                <a href="${rsv.href}" ${rsv.target ? `target="${rsv.target}" rel="${rsv.rel}"` : ''} class="btn btn--stamp" data-reserva-trigger="${v.slug}">Reservar mesa</a>
              </div>
            </div>
          </div>
        `;
      }

      if (response.reserveVenue) {
        const v = response.reserveVenue;
        const rsv = reserveMarkup(v);
        html += `
          <div class="msg msg--ai msg-reserve">
            <a href="${rsv.href}" ${rsv.target ? `target="${rsv.target}" rel="${rsv.rel}"` : ''} class="btn btn--stamp" data-reserva-trigger="${v.slug}">Reservar mesa en ${v.name}</a>
          </div>
        `;
      }

      if (response.replies) {
        html += `<div class="msg-quick-replies">`;
        response.replies.forEach((reply: string) => {
          html += `<button class="quick-reply">${reply}</button>`;
        });
        html += `</div>`;
      }

      chatBox.insertAdjacentHTML('beforeend', html);
      attachQuickReplies();
      scrollToBottom();
    }

    function scrollToBottom() {
      chatBox.scrollTop = chatBox.scrollHeight;
    }

    function attachQuickReplies() {
      const replies = chatBox.querySelectorAll('.quick-reply:not(.bound)');
      replies.forEach((btn) => {
        btn.classList.add('bound');
        btn.addEventListener('click', () => {
          btn.parentElement?.remove();
          handleSend(btn.textContent || '');
        });
      });
    }

    attachQuickReplies();

    async function handleSend(text: string) {
      if (!text.trim()) return;

      appendUserMessage(text);
      input.value = '';

      chatBox.querySelectorAll('.msg-quick-replies').forEach((el) => el.remove());

      typingIndicator.hidden = false;
      scrollToBottom();

      const response = await brain.process(text);

      typingIndicator.hidden = true;
      appendAIMessage(response);
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      handleSend(input.value);
    });
  }

  // Initialize on first load and after every Astro View Transition
  document.addEventListener('astro:page-load', initConcierge);

  initConcierge();
</script>
