---
/**
 * CHAPTER 03 — MADRID
 * The relationship with the city: the 2008 tahona, the barrios, and the growth
 * logic in the founders' own words — "los locales nos llaman".
 * Rendered on the ink surface: the quietest, most cinematic beat of the page.
 */
import { getCollection } from 'astro:content';

const all = await getCollection('restaurants');
const base = import.meta.env.BASE_URL;
const tira = all
  .filter((r) => r.data.openedYear)
  .sort((a, b) => (a.data.openedYear ?? 0) - (b.data.openedYear ?? 0));

const barrios = [
  'Malasaña',
  'Barrio de las Letras',
  'Chamberí',
  'Salamanca',
  'Sol',
  'Chueca',
  'Plaza de España',
  'Hortaleza',
  'Argüelles',
];
---

<!-- WOW 2 «La mancha» — the ink spreads to the edges as the chapter arrives -->
<section class="madrid" id="madrid" data-ink data-ink-spread aria-labelledby="madrid-title">
  <div class="container">
    <header class="capitulo-head" data-reveal>
      <p class="capitulo-num label">Capítulo 03 — Madrid</p>
      <h2 class="capitulo-title" id="madrid-title">
        La ciudad que nos <em>fue llamando</em>
      </h2>
    </header>

    <div class="madrid__grid">
      <div class="madrid__body" data-reveal>
        <p>
          El 1 de mayo de 2008, dos hermanos sin ninguna experiencia en hostelería
          abrieron una tahona que llevaba décadas cerrada en un Malasaña que entonces
          daba respeto. Ofelia venía del teatro — nueve años en Nueva York, muchas
          mesas servidas. Álex, de la ingeniería civil.
        </p>
        <p>
          Aquella carta con pizza, solomillo y tataki en la misma página le pareció
          una locura a todo el mundo. Dieciocho casas después, seguimos sin tener un
          plan de expansión.
        </p>
      </div>

      <div class="madrid__quotes" data-reveal style="--reveal-delay: 140ms">
        <blockquote class="cita">
          <p>«Como éramos inconscientes, abrimos.»</p>
          <cite>Ofelia Marín, cofundadora</cite>
        </blockquote>
        <blockquote class="cita cita--second">
          <p>«Nunca hemos tenido una estrategia de expansión muy clara. Los locales nos llaman.»</p>
          <cite>Lamucca, 2026</cite>
        </blockquote>
      </div>
    </div>

    <!-- Los barrios -->
    <div class="barrios" data-reveal>
      <p class="label barrios__head">Dónde estamos</p>
      <ul class="barrios__list">
        {barrios.map((b) => (
          <li class="tag barrios__item">{b}</li>
        ))}
      </ul>
    </div>
  </div>

  <!-- WOW 3 «El carrete» — one beat per opening. The strip's own horizontal
       scroll fills the progress rule and inks in each year. Native scroll,
       snap, keyboard-navigable: the gesture stays the user's. -->
  <div class="tira-wrap" data-reveal data-reel-scope>
    <p class="label tira__head container">Casa por casa, año por año</p>
    <ol class="tira" tabindex="0" role="list" aria-label="Aperturas de Lamucca por año" data-reel>
      {tira.map((r) => (
        <li class="tira__beat">
          <a href={`${base}restaurantes/${r.data.slug}/`} class="tira__link">
            <span
              class={`tira__tick tira__tick--${r.data.accent}`}
              aria-hidden="true"
              data-reel-tick
            ></span>
            <span class="tira__year">{r.data.openedYear}</span>
            <span class="tira__name">{r.data.name}</span>
            <span class="tira__hood label">{r.data.neighborhood}</span>
          </a>
        </li>
      ))}
    </ol>
    <div class="tira__progress container" aria-hidden="true">
      <span class="tira__progress-fill" data-reel-progress></span>
    </div>
  </div>
</section>

<style>
  .madrid {
    padding-block: var(--space-3xl);
  }

  .madrid__grid {
    display: grid;
    gap: var(--space-xl);
    margin-bottom: var(--space-2xl);
  }

  .madrid__body {
    display: grid;
    gap: var(--space-m);
    font-size: var(--step-1);
    line-height: var(--leading-body);
    color: var(--text-secondary);
    max-width: var(--measure-editorial);
  }

  .madrid__quotes {
    display: grid;
    gap: var(--space-l);
    align-content: start;
  }

  .cita--second p {
    font-size: var(--step-2);
    max-width: 26ch;
  }

  /* --- Los barrios --- */
  .barrios__head {
    color: var(--text-tertiary);
    margin-bottom: var(--space-s);
  }

  .barrios__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .barrios__item {
    border-color: var(--paper);
    color: var(--text-primary);
  }

  /* --- La tira --- */
  .tira-wrap {
    margin-top: var(--space-3xl);
  }

  .tira__head {
    display: block;
    color: var(--text-tertiary);
    margin-bottom: var(--space-l);
  }

  .tira {
    position: relative;
    display: flex;
    list-style: none;
    margin: 0;
    padding: var(--space-l) var(--gutter) var(--space-l);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .tira::-webkit-scrollbar {
    display: none;
  }

  /* Continuous line */
  .tira::before {
    content: '';
    position: absolute;
    top: var(--space-l);
    left: 0;
    right: 0;
    height: var(--rule-width);
    background: var(--line-inverse);
    z-index: 0;
  }

  .tira:focus-visible {
    outline: var(--focus-ring);
    outline-offset: -3px;
  }

  .tira__beat {
    position: relative;
    z-index: 1;
    flex: 0 0 auto;
    scroll-snap-align: start;
    width: 14rem;
    padding-right: var(--space-l);
  }

  .tira__link {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    height: 100%;
    outline: none;
  }

  .tira__tick {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--tomato);
    border: 3px solid var(--ink); /* Cutout effect over the line */
    margin-top: -8px; /* Center perfectly on the line */
    margin-bottom: var(--space-m);
    transition: transform var(--t-micro) var(--ease-out);
  }

  .tira__tick--butter { background: var(--butter); }
  .tira__tick--olive { background: var(--olive); }

  /* Progress rule — fills with the strip's own scroll */
  .tira__progress {
    display: block;
    height: var(--rule-width);
    margin-top: var(--space-m);
    background: var(--line-inverse);
  }

  .tira__progress-fill {
    display: block;
    height: 100%;
    background: var(--paper); /* Better contrast than butter on ink background */
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* Without scroll-driven support the rule reads as a full static underline */
  @supports not (animation-timeline: view()) {
    .tira__progress-fill {
      transform: scaleX(1);
    }
  }

  .tira__year {
    font-family: var(--font-display);
    font-size: var(--step-3);
    font-weight: var(--weight-display);
    line-height: 1;
    color: var(--text-secondary);
    transition: color var(--t-micro) var(--ease-out);
    margin-bottom: var(--space-2xs);
  }

  .tira__name {
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 2px;
  }

  .tira__hood {
    color: var(--text-tertiary);
  }

  @media (hover: hover) {
    .tira__link:hover .tira__year {
      color: var(--paper);
    }
    .tira__link:hover .tira__tick {
      transform: scale(1.3);
    }
  }

  @media (min-width: 900px) {
    .madrid__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
    }
  }
</style>
