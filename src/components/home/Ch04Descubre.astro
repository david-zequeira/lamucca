---
/**
 * CHAPTER 04 — ENCUENTRA TU MUCCA (Mood Discovery)
 * The signature interactive experience: a four-step conversational wizard,
 * not a form. Every dimension it scores against is grounded in data the
 * content model already carries (moods/occasions/times/groups/zone) or in
 * claims the site's own copy already makes — see `deriveDishes` below —
 * never in invented per-venue facts (DESIGN-DECISIONS #006).
 */
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { CollectionEntry } from 'astro:content';

const venues = (await getCollection('restaurants')).sort((a, b) => a.data.order - b.data.order);

const fotos = import.meta.glob<{ default: ImageMetadata }>('../../assets/casas/*.jpg', {
  eager: true,
});

const heroPorSlug = Object.fromEntries(
  await Promise.all(
    venues.map(async (v) => {
      const foto = fotos[`../../assets/casas/${v.data.slug}.jpg`]?.default;
      if (!foto) return [v.data.slug, null];
      const [avif, webp, jpg] = await Promise.all([
        getImage({ src: foto, width: 1000, format: 'avif' }),
        getImage({ src: foto, width: 1000, format: 'webp' }),
        getImage({ src: foto, width: 1000, format: 'jpeg' }),
      ]);
      return [v.data.slug, { avif: avif.src, webp: webp.src, jpg: jpg.src }];
    })
  )
);

/* Dish signals the wizard's "¿qué te apetece comer?" step scores against.
   Derived — never hand-tagged — from claims the site already makes elsewhere:
     · pizza & vegetariano: Ch05Comida's own manifiesto/firmas state these are
       true of the whole group ("en todas las casas" / "vegano o carnívoro"),
       so every venue carries them.
     · hamburguesa: brand-report.md's sourced "cosmopolitan comfort menu"
       (pizza, nachos, burgers) describes the Lamucca-line houses specifically.
     · compartir: the venues whose sourced description centres on shared
       plates — Ultramarines' casquería, La Pescadería's arroces, Kiosco
       Magadán's vermut-and-tapas terrace.
   "Pasta" has no source anywhere in the content, so it scores nothing —
   offered in the UI because the brief asks for it, but never used to claim
   a venue serves it. */
function deriveDishes(concept: string) {
  return {
    pizza: true,
    vegetariano: true,
    hamburguesa: concept === 'lamucca',
    compartir: concept === 'ultramarines' || concept === 'pescaderia' || concept === 'kiosco',
  };
}

const clientVenues = venues.map((v: CollectionEntry<'restaurants'>) => ({
  slug: v.data.slug,
  hero: heroPorSlug[v.data.slug],
  name: v.data.name,
  tagline: v.data.tagline,
  neighborhood: v.data.neighborhood,
  phone: v.data.phone ?? null,
  bookingUrl: v.data.bookingUrl ?? null,
  moods: v.data.moods ?? [],
  occasions: v.data.occasions ?? [],
  times: v.data.times ?? [],
  groups: v.data.groups ?? [],
  zone: v.data.zone ?? null,
  accent: v.data.accent ?? 'tomato',
  dishes: deriveDishes(v.data.concept),
}));

interface Option {
  id: string;
  icon: string;
  label: string;
}

interface Step {
  id: string;
  question: string;
  options: Option[];
}

const STEPS: Step[] = [
  {
    id: 'quien',
    question: '¿Con quién vienes?',
    options: [
      { id: 'cita', icon: '💕', label: 'Una cita' },
      { id: 'amigos', icon: '👯', label: 'Amigos' },
      { id: 'familia', icon: '👨‍👩‍👧', label: 'Familia' },
      { id: 'solo', icon: '🧍', label: 'Solo' },
      { id: 'trabajo', icon: '💼', label: 'Trabajo' },
    ],
  },
  {
    id: 'plan',
    question: '¿Qué plan te apetece?',
    options: [
      { id: 'animado', icon: '🎉', label: 'Algo animado' },
      { id: 'tranquila', icon: '🕯️', label: 'Una cena tranquila' },
      { id: 'madrid', icon: '🎸', label: 'Una noche de Madrid' },
      { id: 'compartir', icon: '🍽️', label: 'Para compartir' },
      { id: 'hambre', icon: '🙌', label: 'Tengo hambre' },
    ],
  },
  {
    id: 'comida',
    question: '¿Qué te apetece comer?',
    options: [
      { id: 'pizza', icon: '🍕', label: 'Pizza' },
      { id: 'pasta', icon: '🍝', label: 'Pasta' },
      { id: 'hamburguesa', icon: '🍔', label: 'Hamburguesa' },
      { id: 'compartir', icon: '🥘', label: 'Para compartir' },
      { id: 'vegetariano', icon: '🥗', label: 'Algo vegetariano' },
    ],
  },
  {
    id: 'zona',
    question: '¿Por dónde te viene bien?',
    options: [
      { id: 'ubicacion', icon: '📍', label: 'Usar mi ubicación' },
      { id: 'barrio', icon: '🗺️', label: 'Elegir barrio' },
      { id: 'igual', icon: '🤷', label: 'Me da igual' },
    ],
  },
];

/* Real zones the content model already uses (src/content.config.ts) — not a
   separate invented geography. "fuera" (Palma) is left off this picker: it's
   reachable only through the other three answers, never something a Madrid
   visitor would deliberately "elegir". */
const BARRIOS = [
  { zone: 'malasana', label: 'Malasaña' },
  { zone: 'centro', label: 'Centro' },
  { zone: 'chamberi', label: 'Chamberí' },
  { zone: 'salamanca', label: 'Salamanca' },
  { zone: 'norte', label: 'Norte' },
  { zone: 'oeste', label: 'Oeste' },
];

const base = import.meta.env.BASE_URL;
---

<section class="finder" id="descubre" aria-labelledby="finder-title" data-finder>
  <div class="container">
    <header class="capitulo-head finder__head" data-reveal>
      <p class="capitulo-num label">Capítulo 04 — Encuentra tu casa</p>
      <h2 class="capitulo-title finder__title" id="finder-title">
        ¿Dónde <em>cenamos</em> hoy?
      </h2>
      <p class="capitulo-sub">Te ayudamos a encontrar tu sitio.</p>
    </header>

    <div class="finder__stage" data-reveal style="--reveal-delay: 120ms">
      <div class="finder__progress">
        <button type="button" class="finder__back" data-back hidden>
          <span aria-hidden="true">←</span> Atrás
        </button>
        <ol class="finder__dots" aria-hidden="true">
          {STEPS.map((_s, i) => (
            <li class="dot" data-dot={i}></li>
          ))}
        </ol>
        <button type="button" class="finder__restart" data-restart-top hidden>
          Volver a empezar
        </button>
      </div>

      <p class="sr-only" role="status" aria-live="polite" data-announce></p>

      <div class="finder__panels">
        {STEPS.map((step, i) => (
          <div
            class="step"
            data-step={i}
            data-step-id={step.id}
            role="group"
            aria-labelledby={`step-q-${step.id}`}
            hidden={i !== 0}
          >
            <h3 class="step__q" id={`step-q-${step.id}`} tabindex="-1">{step.question}</h3>
            <div class="options">
              {step.options.map((o) => (
                <button type="button" class="option" data-option={o.id} aria-pressed="false">
                  <span class="option__icon" aria-hidden="true">{o.icon}</span>
                  <span class="option__label">{o.label}</span>
                </button>
              ))}
            </div>

            {step.id === 'zona' && (
              <div class="barrios-sub" data-barrios-sub hidden>
                <p class="barrios-sub__head label">¿Qué barrio?</p>
                <div class="options options--compact">
                  {BARRIOS.map((b) => (
                    <button type="button" class="option option--compact" data-barrio={b.zone} aria-pressed="false">
                      {b.label}
                    </button>
                  ))}
                  <button type="button" class="option option--compact" data-barrio="any" aria-pressed="false">
                    Cualquier zona
                  </button>
                </div>
              </div>
            )}
          </div>
        ))}

        <div class="result" data-result hidden aria-labelledby="result-title">
          <p class="result__kicker label" tabindex="-1" data-result-kicker>Creemos que tu sitio es...</p>
          <div class="result__card-slot" data-result-card></div>
          <p class="result__foot">
            <button type="button" class="link-reset" data-restart>Volver a empezar</button>
          </p>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ venuesData: clientVenues, baseUrl: base }}>
    window.lamuccaFinderVenues = venuesData;
    window.lamuccaFinderBase = baseUrl;
  </script>

  <script>
    /* Vanilla + WAAPI — the motion system's default engine (see motion.css
       header). No new dependency for a feature this self-contained. */
    const root = document.querySelector<HTMLElement>('[data-finder]');
    const venues = (window as any).lamuccaFinderVenues as any[] | undefined;
    const base = (window as any).lamuccaFinderBase as string | undefined;

    if (root && venues && base !== undefined) {
      const STEP_IDS = ['quien', 'plan', 'comida', 'zona'];
      const stage = root.querySelector<HTMLElement>('.finder__stage')!;
      const panels = root.querySelector<HTMLElement>('.finder__panels')!;
      const steps = Array.from(root.querySelectorAll<HTMLElement>('[data-step]'));
      const dots = Array.from(root.querySelectorAll<HTMLElement>('[data-dot]'));
      const backBtn = root.querySelector<HTMLButtonElement>('[data-back]')!;
      const restartTopBtn = root.querySelector<HTMLButtonElement>('[data-restart-top]')!;
      const announce = root.querySelector<HTMLElement>('[data-announce]')!;
      const resultPanel = root.querySelector<HTMLElement>('[data-result]')!;
      const resultKicker = root.querySelector<HTMLElement>('[data-result-kicker]')!;
      const resultCardSlot = root.querySelector<HTMLElement>('[data-result-card]')!;
      const zonaStep = root.querySelector<HTMLElement>('[data-step-id="zona"]')!;
      const barriosSub = zonaStep.querySelector<HTMLElement>('[data-barrios-sub]')!;

      const EASE_OUT = 'cubic-bezier(0.22, 1, 0.36, 1)'; /* mirrors --ease-out */
      const answers: Record<string, string | null> = { quien: null, plan: null, comida: null, zona: null, barrio: null };
      let current = 0;
      let zonaSubOpen = false;
      let geoZoneBoost = false;
      /* Guards every transition below. Without it, a click landing while the
         previous swap() is still resolving — a fast double-tap, or the
         timers above simply running slower than their nominal duration —
         starts a second goToStep on top of the first, and their hidden-flag
         writes interleave into a genuinely broken multi-step-visible state. */
      let busy = false;

      /* ---------------------------------------------------------------
         Scoring — every venue is scored across whichever steps have been
         answered; highest score wins, ties broken at random. Never zero
         candidates: step "quien" alone always separates at least a few
         venues, and the fallback below covers any pathological tie.
         --------------------------------------------------------------- */
      const SCORERS: Record<string, Record<string, (v: any) => number>> = {
        quien: {
          cita: (v) => (v.occasions.includes('pareja') ? 3 : 0),
          amigos: (v) => (v.occasions.includes('amigos') ? 3 : 0),
          familia: (v) => (v.occasions.includes('familia') ? 3 : 0),
          solo: (v) => (v.groups.includes('solo') ? 3 : 0),
          trabajo: (v) => (v.occasions.includes('trabajo') ? 3 : 0),
        },
        plan: {
          animado: (v) => (v.moods.includes('animado') ? 3 : 0),
          tranquila: (v) => (v.moods.includes('tranquilo') ? 3 : 0),
          madrid: (v) => (v.moods.includes('castizo') ? 3 : v.times.includes('tarde') ? 1.5 : 0),
          compartir: (v) => (v.dishes.compartir ? 3 : v.groups.includes('muchos') ? 1 : 0),
          hambre: () => 0,
        },
        comida: {
          pizza: (v) => (v.dishes.pizza ? 1 : 0),
          pasta: () => 0,
          hamburguesa: (v) => (v.dishes.hamburguesa ? 3 : 0),
          compartir: (v) => (v.dishes.compartir ? 3 : 0),
          vegetariano: (v) => (v.dishes.vegetariano ? 1 : 0),
        },
        zona: {
          ubicacion: (v) => (geoZoneBoost && ['centro', 'malasana', 'chamberi'].includes(v.zone) ? 1 : 0),
          barrio: (v) => (answers.barrio && answers.barrio !== 'any' && v.zone === answers.barrio ? 2 : 0),
          igual: () => 0,
        },
      };

      function scoreVenue(v: any): number {
        let s = 0;
        for (const stepId of STEP_IDS) {
          const answer = answers[stepId];
          if (!answer) continue;
          const fn = SCORERS[stepId]?.[answer];
          if (fn) s += fn(v);
        }
        return s;
      }

      function pickVenue() {
        const scored = venues.map((v) => ({ v, s: scoreVenue(v) }));
        const max = Math.max(...scored.map((x) => x.s));
        const top = scored.filter((x) => x.s === max).map((x) => x.v);
        return top[Math.floor(Math.random() * top.length)];
      }

      /* ---------------------------------------------------------------
         Why-text — built only from the visitor's own answers, never from
         claims about the specific venue, so it can never say something
         false. Mirrors the brand voice (docs/strategy/brand-strategy.md).
         --------------------------------------------------------------- */
      const OCCASION_PHRASE: Record<string, string> = {
        cita: 'una cita',
        amigos: 'una noche con amigos',
        familia: 'un plan en familia',
        solo: 'una comida a tu ritmo',
        trabajo: 'una comida de trabajo',
      };
      const PLAN_PHRASE: Record<string, string> = {
        animado: 'con ambiente animado y buena música',
        tranquila: 'tranquila, para hablar con calma',
        madrid: 'con ese punto castizo y madrileño',
        compartir: 'de esas que se alargan compartiendo mesa',
        hambre: 'sin complicarte la vida',
      };
      const FOOD_PHRASE: Record<string, string> = {
        pizza: ' y buena pizza',
        hamburguesa: ' y unas hamburguesas de las buenas',
        compartir: ' para picar de todo',
        vegetariano: ' cuidando también las opciones vegetarianas',
      };

      function buildWhy(): string {
        const occ = (answers.quien && OCCASION_PHRASE[answers.quien]) || 'tu plan de hoy';
        const plan = (answers.plan && PLAN_PHRASE[answers.plan]) || '';
        const food = (answers.comida && FOOD_PHRASE[answers.comida]) || '';
        let sentence = `Para ${occ}`;
        if (plan) sentence += `, ${plan}`;
        sentence += `${food}.`;
        return sentence;
      }

      /* ---------------------------------------------------------------
         Geolocation — a soft, honest signal only. Uses one well-known
         public reference point (Puerta del Sol, the real centre of
         Madrid) to detect "are we roughly in central Madrid"; never
         claims distance to any specific casa, since no venue in the
         content model carries real coordinates. Silent on denial,
         timeout, or an unsupported browser — the flow simply proceeds
         as if "me da igual" had been chosen.
         --------------------------------------------------------------- */
      function haversineKm(lat1: number, lon1: number, lat2: number, lon2: number) {
        const R = 6371;
        const dLat = ((lat2 - lat1) * Math.PI) / 180;
        const dLon = ((lon2 - lon1) * Math.PI) / 180;
        const a =
          Math.sin(dLat / 2) ** 2 +
          Math.cos((lat1 * Math.PI) / 180) * Math.cos((lat2 * Math.PI) / 180) * Math.sin(dLon / 2) ** 2;
        return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
      }

      function requestGeo(): Promise<boolean> {
        if (!('geolocation' in navigator)) return Promise.resolve(false);
        return new Promise((resolve) => {
          let settled = false;
          const done = (v: boolean) => {
            if (settled) return;
            settled = true;
            resolve(v);
          };
          const timer = window.setTimeout(() => done(false), 3000);
          navigator.geolocation.getCurrentPosition(
            (pos) => {
              window.clearTimeout(timer);
              const SOL = { lat: 40.4169, lon: -3.7035 };
              const km = haversineKm(pos.coords.latitude, pos.coords.longitude, SOL.lat, SOL.lon);
              done(km < 3);
            },
            () => {
              window.clearTimeout(timer);
              done(false);
            },
            { timeout: 2800, maximumAge: 300000 }
          );
        });
      }

      /* ---------------------------------------------------------------
         Motion — the whole panel moves as one block (never per-child),
         translateX 40px in the travel direction, 250–450ms, no bounce.
         --------------------------------------------------------------- */
      function reducedMotion() {
        return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      }

      /* A cancelled Animation — including one implicitly dropped when its
         target is hidden or removed mid-flight — rejects its own .finished
         with an AbortError. None of the animations here are ever awaited a
         second time, so left alone that's an unhandled rejection on every
         fast click-through or backgrounded tab. Every .animate() call in
         this file is routed through here for that reason. */
      function silence<T extends Animation>(anim: T): T {
        anim.finished.catch(() => {});
        return anim;
      }

      function pulseSelect(el: HTMLElement) {
        if (reducedMotion()) return;
        silence(
          el.animate([{ scale: 1 }, { scale: 1.02 }, { scale: 1 }], { duration: 280, easing: 'ease-out' })
        );
      }

      /* The page's own Page Visibility API — not our data — decides when
         animations pause (e.g. the visitor alt-tabs mid-transition). Racing
         against a hard timeout means the step still lands in its end state
         instead of leaving the wizard stuck on a half-slid panel. */
      function settle(anim: Animation, ms: number): Promise<unknown> {
        return Promise.race([silence(anim).finished, new Promise((resolve) => window.setTimeout(resolve, ms))]);
      }

      async function swap(outEl: HTMLElement | null, inEl: HTMLElement, dir: 1 | -1) {
        const distance = 40 * dir;
        if (reducedMotion()) {
          if (outEl) outEl.hidden = true;
          inEl.hidden = false;
          return;
        }
        if (outEl) {
          const out = outEl.animate(
            [
              { transform: 'translateX(0)', opacity: 1 },
              { transform: `translateX(${-distance}px)`, opacity: 0 },
            ],
            { duration: 260, easing: EASE_OUT, fill: 'forwards' }
          );
          await settle(out, 400);
          outEl.hidden = true;
          outEl.getAnimations().forEach((a) => a.cancel());
        }
        inEl.hidden = false;
        const inAnim = inEl.animate(
          [
            { transform: `translateX(${distance}px)`, opacity: 0 },
            { transform: 'translateX(0)', opacity: 1 },
          ],
          { duration: 380, easing: EASE_OUT, fill: 'both' }
        );
        await settle(inAnim, 520);
        inEl.getAnimations().forEach((a) => a.cancel());
      }

      function updateProgress() {
        dots.forEach((d, i) => {
          d.classList.toggle('is-active', i === current);
          d.classList.toggle('is-done', i < current);
        });
        backBtn.hidden = current === 0 && !zonaSubOpen;
        restartTopBtn.hidden = current === 0;
      }

      function focusHeading(el: HTMLElement) {
        const heading = el.matches('[data-result]') ? resultKicker : el.querySelector<HTMLElement>('.step__q');
        heading?.focus({ preventScroll: true });
      }

      function markPersisted(stepEl: HTMLElement) {
        const stepId = stepEl.dataset.stepId!;
        const saved = answers[stepId];
        stepEl.querySelectorAll<HTMLButtonElement>('.option').forEach((btn) => {
          btn.setAttribute('aria-pressed', String(btn.dataset.option === saved));
        });
      }

      async function goToStep(index: number, dir: 1 | -1) {
        busy = true;
        try {
          const from = resultPanel.hidden ? steps[current] : resultPanel;
          const to = steps[index];
          current = index;
          markPersisted(to);
          await swap(from, to, dir);
          updateProgress();
          focusHeading(to);
          const question = to.querySelector('.step__q')?.textContent ?? '';
          announce.textContent = `Paso ${index + 1} de ${steps.length}: ${question}`;
        } finally {
          busy = false;
        }
      }

      async function showResult() {
        busy = true;
        try {
          const venue = pickVenue();
          renderResult(venue);
          await swap(steps[current], resultPanel, 1);
          backBtn.hidden = false;
          restartTopBtn.hidden = false;
          dots.forEach((d) => d.classList.add('is-done'));
          focusHeading(resultPanel);
          announce.textContent = 'Tu recomendación está lista.';
        } finally {
          busy = false;
        }
      }

      function renderResult(venue: any) {
        const why = buildWhy();
        const cta = venue.bookingUrl
          ? `<a class="btn btn--stamp" href="${venue.bookingUrl}" target="_blank" rel="noopener" data-book="${venue.slug}">Reservar mesa</a>`
          : venue.phone
            ? `<a class="btn btn--stamp" href="tel:+34${venue.phone}">Llamar para reservar</a>`
            : `<a class="btn btn--stamp" href="${base}restaurantes/${venue.slug}/">Ver disponibilidad</a>`;

        resultCardSlot.innerHTML = `
          <article class="result__card" data-venue>
            <a class="result__image campo campo--${venue.accent}" href="${base}restaurantes/${venue.slug}/">
              ${
                venue.hero
                  ? `<picture>
                <source type="image/avif" srcset="${venue.hero.avif}" />
                <source type="image/webp" srcset="${venue.hero.webp}" />
                <img src="${venue.hero.jpg}" alt="Interior de ${venue.name}" loading="eager" decoding="async" fetchpriority="high" />
              </picture>`
                  : ''
              }
            </a>
            <div class="result__body">
              <h3 class="result__name" id="result-title" tabindex="-1">${venue.name}</h3>
              <p class="result__hood label">${venue.neighborhood}</p>
              <p class="result__tag voice">${venue.tagline}</p>
              <p class="result__why">${why}</p>
              <div class="result__actions">
                <a class="btn" href="${base}restaurantes/${venue.slug}/">Ver restaurante</a>
                ${cta}
              </div>
            </div>
          </article>
        `;

        if (!reducedMotion()) {
          const img = resultCardSlot.querySelector<HTMLElement>('img');
          if (img) {
            silence(
              img.animate(
                [
                  { transform: 'scale(1.05)', opacity: 0 },
                  { transform: 'scale(1)', opacity: 1 },
                ],
                { duration: 500, easing: EASE_OUT, fill: 'both' }
              )
            );
          }
        }
      }

      function resetAll() {
        answers.quien = answers.plan = answers.comida = answers.zona = answers.barrio = null;
        geoZoneBoost = false;
        zonaSubOpen = false;
        barriosSub.hidden = true;
        barriosSub.querySelectorAll<HTMLButtonElement>('.option').forEach((b) => b.setAttribute('aria-pressed', 'false'));
        root!.querySelectorAll<HTMLButtonElement>('.option').forEach((b) => b.setAttribute('aria-pressed', 'false'));
        resultPanel.hidden = true;
        resultCardSlot.innerHTML = '';
        steps.forEach((s, i) => {
          s.hidden = i !== 0;
        });
        current = 0;
        updateProgress();
        focusHeading(steps[0]);
        announce.textContent = 'Volvemos a empezar.';
        stage.scrollIntoView({ behavior: reducedMotion() ? 'auto' : 'smooth', block: 'start' });
      }

      /* ---------------------------------------------------------------
         Wiring
         --------------------------------------------------------------- */
      steps.forEach((stepEl) => {
        const stepId = stepEl.dataset.stepId!;
        const optionButtons = Array.from(
          stepEl.querySelectorAll<HTMLButtonElement>(':scope > .options > .option')
        );

        optionButtons.forEach((btn) => {
          btn.addEventListener('click', async () => {
            /* Set the instant a click is accepted, not once the delayed
               goToStep/showResult call actually starts — otherwise a second
               click landing during the 320–380ms pause before that call
               still slips through and races it. */
            if (busy) return;
            busy = true;

            const optionId = btn.dataset.option!;
            optionButtons.forEach((b) => b.setAttribute('aria-pressed', 'false'));
            btn.setAttribute('aria-pressed', 'true');
            pulseSelect(btn);
            answers[stepId] = optionId;

            if (stepId === 'zona') {
              if (optionId === 'barrio') {
                zonaSubOpen = true;
                backBtn.hidden = false;
                barriosSub.hidden = false;
                if (!reducedMotion()) {
                  silence(
                    barriosSub.animate(
                      [
                        { transform: 'translateY(8px)', opacity: 0 },
                        { transform: 'translateY(0)', opacity: 1 },
                      ],
                      { duration: 320, easing: EASE_OUT }
                    )
                  );
                }
                barriosSub.querySelector<HTMLElement>('.option')?.focus();
                busy = false; /* nothing pending — the next click is the barrio choice itself */
                return;
              }
              if (optionId === 'ubicacion') {
                btn.setAttribute('aria-busy', 'true');
                const label = btn.querySelector('.option__label')!;
                const original = label.textContent;
                label.textContent = 'Buscando tu zona…';
                geoZoneBoost = await requestGeo();
                label.textContent = original;
                btn.removeAttribute('aria-busy');
              }
              window.setTimeout(showResult, 320);
              return;
            }

            window.setTimeout(() => {
              if (current < steps.length - 1) goToStep(current + 1, 1);
              else busy = false;
            }, 380);
          });
        });
      });

      barriosSub.querySelectorAll<HTMLButtonElement>('[data-barrio]').forEach((btn) => {
        btn.addEventListener('click', () => {
          if (busy) return;
          busy = true;
          barriosSub
            .querySelectorAll<HTMLButtonElement>('[data-barrio]')
            .forEach((b) => b.setAttribute('aria-pressed', 'false'));
          btn.setAttribute('aria-pressed', 'true');
          pulseSelect(btn);
          answers.barrio = btn.dataset.barrio === 'any' ? null : btn.dataset.barrio!;
          /* The sub-picker's own job is done — clear it so the first "Atrás"
             from the result goes to step 4, not to silently re-collapsing an
             already-resolved sub-picker (that stale flag was leaving back
             navigation stuck on the result screen). */
          zonaSubOpen = false;
          window.setTimeout(showResult, 320);
        });
      });

      backBtn.addEventListener('click', () => {
        if (busy) return;
        if (zonaSubOpen) {
          zonaSubOpen = false;
          barriosSub.hidden = true;
          backBtn.hidden = current === 0;
          return;
        }
        if (!resultPanel.hidden) {
          goToStep(steps.length - 1, -1);
          return;
        }
        if (current > 0) goToStep(current - 1, -1);
      });

      restartTopBtn.addEventListener('click', () => {
        if (!busy) resetAll();
      });
      resultPanel.querySelector<HTMLButtonElement>('[data-restart]')!.addEventListener('click', () => {
        if (!busy) resetAll();
      });

      updateProgress();
    }
  </script>
</section>

