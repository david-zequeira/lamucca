---
/**
 * CHAPTER 04 — FIND YOUR MUCCA
 * The signature interactive experience of the La Mucca website.
 */
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const venues = (await getCollection('restaurants')).sort((a, b) => a.data.order - b.data.order);

const fotos = import.meta.glob<{ default: ImageMetadata }>('../../assets/casas/*.jpg', {
  eager: true,
});

const heroPorSlug = Object.fromEntries(
  await Promise.all(
    venues.map(async (v) => {
      const foto = fotos[`../../assets/casas/${v.data.slug}.jpg`]?.default;
      if (!foto) return [v.data.slug, null];
      const [avif, webp, jpg] = await Promise.all([
        getImage({ src: foto, width: 1000, format: 'avif' }),
        getImage({ src: foto, width: 1000, format: 'webp' }),
        getImage({ src: foto, width: 1000, format: 'jpeg' }),
      ]);
      return [v.data.slug, { avif: avif.src, webp: webp.src, jpg: jpg.src }];
    })
  )
);

const clientVenues = venues.map(v => ({
  slug: v.data.slug,
  hero: heroPorSlug[v.data.slug],
  name: v.data.name,
  tagline: v.data.tagline,
  neighborhood: v.data.neighborhood,
  address: v.data.address,
  bookingUrl: v.data.bookingUrl,
  moods: v.data.moods || [],
  occasions: v.data.occasions || [],
  times: v.data.times || [],
  features: v.data.features || [],
  character: v.data.character || [],
  accent: v.data.accent || 'tomato'
}));
---

<section class="find-mucca" id="descubre" aria-labelledby="descubre-title">
  <div class="container find-mucca__container">
    
    <header class="find-mucca__header" data-main-header>
      <h2 class="find-mucca__title" id="descubre-title">¿DÓNDE CENAMOS HOY?</h2>
      <p class="find-mucca__subtitle">Te ayudamos a encontrar tu sitio.</p>
    </header>

    <div class="find-mucca__interactive" data-interactive>
      
      <!-- Steps Container -->
      <div class="find-mucca__steps-wrapper" data-steps-wrapper aria-live="polite">
        <div class="find-mucca__step-header">
          <button type="button" class="btn-back" data-back hidden aria-label="Volver">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          </button>
          <h3 class="find-mucca__question" data-question></h3>
        </div>

        <div class="find-mucca__options" data-options>
          <!-- Option cards injected here -->
        </div>
      </div>

      <!-- Result Container -->
      <div class="find-mucca__result" data-result hidden aria-live="polite">
        <div class="result-header">
          <h3 class="result-title">CREEMOS QUE TU SITIO ES...</h3>
        </div>
        <div class="result-card" data-result-card>
          <!-- Card injected here -->
        </div>
        <div class="result-actions">
          <button type="button" class="btn-restart" data-restart>Empezar de nuevo</button>
        </div>
      </div>

    </div>
  </div>

  <script is:inline define:vars={{ venuesData: clientVenues }}>
    window.lamuccaVenues = venuesData;
  </script>

  <script>
    import gsap from 'gsap';

    const stepsData = [
      {
        id: 'who',
        question: '¿CON QUIÉN VIENES?',
        options: [
          { id: 'cita', label: 'Una cita' },
          { id: 'amigos', label: 'Amigos' },
          { id: 'familia', label: 'Familia' },
          { id: 'solo', label: 'Solo' },
          { id: 'trabajo', label: 'Trabajo' }
        ]
      },
      {
        id: 'mood',
        question: '¿QUÉ PLAN TE APETECE?',
        options: [
          { id: 'animado', label: 'Algo animado' },
          { id: 'tranquila', label: 'Una cena tranquila' },
          { id: 'madrid', label: 'Una noche de Madrid' },
          { id: 'compartir', label: 'Para compartir' },
          { id: 'hambre', label: 'Tengo hambre' }
        ]
      },
      {
        id: 'food',
        question: '¿QUÉ TE APETECE COMER?',
        options: [
          { id: 'pizza', label: 'Pizza' },
          { id: 'pasta', label: 'Pasta' },
          { id: 'hamburguesa', label: 'Hamburguesa' },
          { id: 'compartir-comida', label: 'Para compartir' },
          { id: 'vegetariano', label: 'Algo vegetariano' }
        ]
      },
      {
        id: 'location',
        question: '¿POR DÓNDE TE VIENE BIEN?',
        options: [
          { id: 'ubicacion', label: 'Usar mi ubicación' },
          { id: 'barrio', label: 'Elegir barrio' },
          { id: 'igual', label: 'Me da igual' }
        ]
      }
    ];

    let currentStepIndex = 0;
    let selections = {};

    const interactiveEl = document.querySelector('[data-interactive]');
    const stepsWrapper = document.querySelector('[data-steps-wrapper]');
    const questionEl = document.querySelector('[data-question]');
    const optionsEl = document.querySelector('[data-options]');
    const backBtn = document.querySelector('[data-back]');
    
    const resultEl = document.querySelector('[data-result]');
    const resultCardEl = document.querySelector('[data-result-card]');
    const restartBtn = document.querySelector('[data-restart]');
    const mainHeader = document.querySelector('[data-main-header]');

    if (interactiveEl && window.lamuccaVenues) {
      init();
    }

    function init() {
      renderStep(currentStepIndex, 0);
      
      backBtn.addEventListener('click', () => {
        if (currentStepIndex > 0) {
          currentStepIndex--;
          renderStep(currentStepIndex, -1);
        }
      });

      restartBtn.addEventListener('click', () => {
        currentStepIndex = 0;
        selections = {};
        
        gsap.to(resultEl, {
          opacity: 0,
          y: 20,
          duration: 0.3,
          onComplete: () => {
            resultEl.hidden = true;
            mainHeader.hidden = false;
            stepsWrapper.hidden = false;
            
            gsap.fromTo(mainHeader, { opacity: 0 }, { opacity: 1, duration: 0.4 });
            renderStep(currentStepIndex, -1);
          }
        });
      });
    }

    function renderStep(index, direction) {
      const step = stepsData[index];
      
      if (index === 0) {
        backBtn.hidden = true;
      } else {
        backBtn.hidden = false;
      }

      const currentQuestion = questionEl.textContent;

      const tl = gsap.timeline({
        onComplete: () => {
          questionEl.textContent = step.question;
          optionsEl.innerHTML = step.options.map(opt => `
            <button type="button" class="option-card" data-id="${opt.id}">
              <span class="option-label">${opt.label}</span>
            </button>
          `).join('');

          const newCards = optionsEl.querySelectorAll('.option-card');
          newCards.forEach(card => {
            card.addEventListener('click', (e) => handleOptionClick(e, step.id, card.getAttribute('data-id'), card));
          });

          const xOffset = direction === 1 ? 40 : (direction === -1 ? -40 : 0);
          
          gsap.fromTo([questionEl, optionsEl], 
            { x: xOffset, opacity: 0 }, 
            { x: 0, opacity: 1, duration: 0.35, ease: 'power2.out' }
          );
        }
      });

      if (currentQuestion) {
        const outX = direction === 1 ? -40 : (direction === -1 ? 40 : 0);
        tl.to([questionEl, optionsEl], {
          x: outX,
          opacity: 0,
          duration: 0.25,
          ease: 'power2.in'
        });
      }
    }

    function handleOptionClick(e, stepId, optionId, cardEl) {
      selections[stepId] = optionId;
      
      // Preload image if we are at the last step
      if (currentStepIndex === stepsData.length - 1) {
        const venue = pickVenue(selections);
        if (venue && venue.hero) {
          const img = new Image();
          img.src = venue.hero.jpg;
        }
      }
      
      // Scale: 1 -> 1.02 -> 1 with subtle spring physics
      gsap.to(cardEl, {
        scale: 1.02,
        duration: 0.15,
        ease: 'power1.out',
        onComplete: () => {
          gsap.to(cardEl, {
            scale: 1,
            duration: 0.3,
            ease: 'back.out(1.5)' // subtle spring
          });
          
          setTimeout(() => {
            if (currentStepIndex < stepsData.length - 1) {
              currentStepIndex++;
              renderStep(currentStepIndex, 1);
            } else {
              showResult(cardEl);
            }
          }, 150);
        }
      });
    }

    function showResult(selectedCardEl) {
      const venue = pickVenue(selections);
      const base = import.meta.env.BASE_URL;

      const html = `
        <div class="result-venue">
          <div class="result-venue__image-wrapper" data-result-image>
            ${venue.hero
              ? `<picture>
              <source type="image/avif" srcset="${venue.hero.avif}" />
              <source type="image/webp" srcset="${venue.hero.webp}" />
              <img
                src="${venue.hero.jpg}"
                alt="${venue.name}"
                loading="eager"
                decoding="sync"
              />
            </picture>`
              : ''}
          </div>
          <div class="result-venue__content" data-result-content>
            <h4 class="result-venue__name">${venue.name}</h4>
            <p class="result-venue__barrio">${venue.neighborhood}</p>
            <p class="result-venue__why">${getWhyText(selections, venue)}</p>
            
            <div class="result-venue__actions">
              <a href="${base}restaurantes/${venue.slug}/" class="btn btn--secondary">VER RESTAURANTE</a>
              ${venue.bookingUrl ? `<a href="${venue.bookingUrl}" target="_blank" rel="noopener" class="btn btn--primary">RESERVAR MESA</a>` : ''}
            </div>
          </div>
        </div>
      `;

      resultCardEl.innerHTML = html;

      const cardRect = selectedCardEl.getBoundingClientRect();
      
      gsap.to([mainHeader, stepsWrapper], {
        opacity: 0,
        duration: 0.3,
        ease: 'power2.inOut',
        onComplete: () => {
          mainHeader.hidden = true;
          stepsWrapper.hidden = true;
          resultEl.hidden = false;

          const resultImage = resultEl.querySelector('[data-result-image]');
          const resultContent = resultEl.querySelector('[data-result-content]');
          const resultTitle = resultEl.querySelector('.result-title');
          
          const imgRect = resultImage.getBoundingClientRect();
          
          const dx = cardRect.left - imgRect.left;
          const dy = cardRect.top - imgRect.top;
          
          gsap.fromTo(resultTitle, { opacity: 0, y: 20 }, { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out' });
          
          gsap.fromTo(resultImage, 
            { 
              x: dx, 
              y: dy, 
              scale: 1.05,
              opacity: 0
            },
            { 
              x: 0, 
              y: 0, 
              scale: 1, 
              opacity: 1, 
              duration: 0.45, 
              ease: 'power2.out' 
            }
          );

          gsap.fromTo(resultContent,
            { opacity: 0, y: 30 },
            { opacity: 1, y: 0, duration: 0.4, ease: 'power2.out', delay: 0.15 }
          );
        }
      });
    }

    function pickVenue(sels) {
      let bestMatch = window.lamuccaVenues[0];
      let maxScore = -1;

      window.lamuccaVenues.forEach(v => {
        let score = 0;
        
        if (sels.who === 'cita' && v.occasions.includes('pareja')) score += 2;
        if (sels.who === 'amigos' && v.occasions.includes('amigos')) score += 2;
        if (sels.who === 'familia' && v.occasions.includes('familia')) score += 2;
        if (sels.who === 'trabajo' && v.occasions.includes('trabajo')) score += 2;

        if (sels.mood === 'animado' && v.moods.includes('animado')) score += 2;
        if (sels.mood === 'tranquila' && v.moods.includes('tranquilo')) score += 2;
        if (sels.mood === 'madrid' && v.moods.includes('castizo')) score += 2;

        if (sels.food === 'pizza' && v.character.some(c => c.toLowerCase().includes('pizza'))) score += 3;
        if (sels.food === 'pizza' && v.name === 'Lamucca de Pez') score += 2;

        if (score > maxScore) {
          maxScore = score;
          bestMatch = v;
        }
      });

      return bestMatch;
    }

    function getWhyText(sels, venue) {
      let text = "Para ";
      
      if (sels.who === 'cita') text += "una cita especial, ";
      else if (sels.who === 'amigos') text += "una noche con amigos, ";
      else if (sels.who === 'familia') text += "disfrutar en familia, ";
      else if (sels.who === 'solo') text += "un momento para ti, ";
      else text += "cualquier ocasión, ";

      text += "buena comida y ";

      if (sels.mood === 'animado') text += "un poco de movimiento.";
      else if (sels.mood === 'tranquila') text += "un ambiente relajado.";
      else if (sels.mood === 'madrid') text += "sentir la energía de Madrid.";
      else text += "el mejor ambiente.";

      return text;
    }
  </script>
</section>

<style>
  .find-mucca {
    padding-block: var(--space-3xl);
    background: var(--surface-page);
    overflow: hidden;
    position: relative;
  }

  .find-mucca__container {
    max-width: var(--container-narrow);
    margin: 0 auto;
    padding-inline: var(--gutter);
  }

  .find-mucca__header {
    text-align: center;
    margin-bottom: var(--space-xl);
  }

  .find-mucca__title {
    font-size: var(--step-3);
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: var(--track-tight);
    line-height: var(--leading-title);
    margin-bottom: var(--space-2xs);
  }

  .find-mucca__subtitle {
    font-size: var(--step-1);
    color: var(--text-tertiary);
  }

  .find-mucca__interactive {
    max-width: 600px;
    margin: 0 auto;
    position: relative;
    min-height: 480px;
  }

  .find-mucca__step-header {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    margin-bottom: var(--space-l);
    min-height: 48px;
  }

  .btn-back {
    background: transparent;
    border: none;
    color: var(--text-tertiary);
    cursor: pointer;
    padding: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background var(--t-micro) var(--ease-out), color var(--t-micro) var(--ease-out);
    margin-left: -12px;
  }

  .btn-back:hover {
    background: var(--surface-raised);
    color: var(--text-primary);
  }

  .find-mucca__question {
    font-size: var(--step-2);
    font-family: var(--font-display);
    margin: 0;
    letter-spacing: var(--track-title);
  }

  .find-mucca__options {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .option-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 72px;
    padding: var(--space-m) var(--space-m);
    background: var(--surface-raised);
    border: var(--rule-width) solid var(--line);
    border-radius: var(--radius-card);
    cursor: pointer;
    text-align: left;
    transition: border-color var(--t-micro) var(--ease-out), background var(--t-micro) var(--ease-out);
    will-change: transform;
  }

  .option-card:hover {
    border-color: var(--text-primary);
    background: var(--surface-page);
  }

  .option-label {
    font-size: var(--step-1);
    font-family: var(--font-text);
    font-weight: var(--weight-medium);
    color: var(--text-primary);
  }

  /* Result Styles */
  .find-mucca__result {
    display: flex;
    flex-direction: column;
    gap: var(--space-l);
    position: absolute;
    inset: 0;
    width: 100%;
  }

  .result-header {
    text-align: center;
  }

  .result-title {
    font-size: var(--step--1);
    color: var(--text-tertiary);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    font-family: var(--font-text);
    font-weight: var(--weight-label);
  }

  .result-venue {
    background: var(--surface-raised);
    border-radius: var(--radius-card);
    overflow: hidden;
    border: var(--rule-width) solid var(--line);
    box-shadow: var(--shadow-print);
  }

  .result-venue__image-wrapper {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    position: relative;
    will-change: transform, opacity;
    border-bottom: var(--rule-width) solid var(--line);
  }

  .result-venue__image-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.9;
    mix-blend-mode: var(--img-blend);
  }

  .result-venue__content {
    padding: var(--space-l);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .result-venue__name {
    font-size: var(--step-3);
    font-family: var(--font-display);
    text-transform: uppercase;
    margin-bottom: 4px;
    letter-spacing: var(--track-tight);
  }

  .result-venue__barrio {
    font-size: var(--step--1);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: var(--track-label);
    margin-bottom: var(--space-m);
    font-family: var(--font-text);
  }

  .result-venue__why {
    font-size: var(--step-0);
    line-height: var(--leading-body);
    color: var(--text-secondary);
    max-width: 42ch;
    margin: 0 auto var(--space-xl);
    text-wrap: pretty;
  }

  .result-venue__actions {
    display: flex;
    gap: var(--space-m);
    justify-content: center;
    flex-wrap: wrap;
    width: 100%;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.6em 1.5em;
    border-radius: var(--radius-pill);
    font-weight: var(--weight-stamp);
    text-transform: uppercase;
    letter-spacing: var(--track-stamp);
    text-decoration: none;
    font-size: var(--step--1);
    min-height: 48px;
    cursor: pointer;
    font-family: var(--font-text);
    transition: background var(--t-micro) var(--ease-out), color var(--t-micro) var(--ease-out), border-color var(--t-micro) var(--ease-out);
  }

  .btn--primary {
    background: var(--stamp-fill);
    color: var(--stamp-text);
    border: var(--rule-width) solid var(--stamp-fill);
  }
  
  .btn--primary:hover {
    background: var(--stamp-fill-hover);
    border-color: var(--stamp-fill-hover);
  }

  .btn--secondary {
    background: transparent;
    color: var(--text-primary);
    border: var(--rule-width) solid var(--text-primary);
  }
  
  .btn--secondary:hover {
    background: var(--text-primary);
    color: var(--surface-page);
  }

  .result-actions {
    text-align: center;
    margin-top: var(--space-m);
  }

  .btn-restart {
    background: transparent;
    border: none;
    color: var(--text-tertiary);
    text-decoration: underline;
    cursor: pointer;
    font-size: var(--step--1);
    padding: 8px;
    min-height: 44px;
    transition: color var(--t-micro) var(--ease-out);
    font-family: var(--font-text);
  }
  
  .btn-restart:hover {
    color: var(--text-primary);
  }

  /* Mobile horizontal swipe */
  @media (max-width: 700px) {
    .find-mucca__interactive {
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
    }

    .find-mucca__options {
      flex-direction: row;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: var(--space-m);
      scrollbar-width: none;
      -ms-overflow-style: none;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
    }
    
    .find-mucca__options::-webkit-scrollbar {
      display: none;
    }

    .option-card {
      flex: 0 0 85%;
      scroll-snap-align: center;
      height: 140px;
      justify-content: center;
      text-align: center;
    }

    .result-venue__actions {
      flex-direction: column;
    }
    
    .btn {
      width: 100%;
    }
    
    .find-mucca__result {
      padding-inline: var(--gutter);
    }
    
    .result-venue__content {
      padding: var(--space-m);
    }
  }
</style>
