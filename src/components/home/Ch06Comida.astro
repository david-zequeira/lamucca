---
/**
 * CHAPTER 06 — LA COMIDA
 * Built on the brand's own verb chain (their OG copy: "¿Desayunar, Aperitivear,
 * Comer, Tapear, Merendar, Cenar y Recenar en Madrid?"). The verb matching the
 * current Madrid daypart lights up — the edition mechanic, applied to appetite.
 *
 * The gallery below shows five real, sourced signature dishes (see each
 * restaurant's own `character`/`features` field in src/content/restaurants —
 * DESIGN-DECISIONS #006, content honesty). There is no dish photography in
 * this repo, so each tile uses that dish's real restaurant photo rather than
 * an invented or AI-generated food shot — alt text describes what the photo
 * actually shows (the room), never claims to be a close-up of the plate.
 *
 * No prices are shown: none are verified or published. The discovery panel
 * says so plainly instead of inventing a figure. "Ver menú" links to the
 * dish's real restaurant page (no restaurant publishes a menuUrl yet); there
 * is no live external menu to link to.
 */
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const verbos = [
  { verb: 'Desayunar', edition: 'manana', what: 'Pan de En Bruto y café de especialidad premiado.' },
  { verb: 'Aperitivear', edition: 'aperitivo', what: 'Vermut con torreznos en la barra de Ultramarines.' },
  { verb: 'Comer', edition: 'aperitivo', what: 'La pizza de boletus. La de siempre. La que no se cambia.' },
  { verb: 'Tapear', edition: 'tarde', what: 'Nachos, casquería fina, lo que caiga en la barra.' },
  { verb: 'Merendar', edition: 'tarde', what: 'Pastelería del obrador y kombucha orgánica.' },
  { verb: 'Cenar', edition: 'noche', what: 'Steak tartare, arroces, parrilla orgánica, pad thai.' },
  { verb: 'Recenar', edition: 'noche', what: 'Porque «cenas que acaban en baile» también es una carta.' },
];

interface Dish {
  slug: string;
  name: string;
  where: string;
  restaurantSlug: string;
  restaurantName: string;
  role: 'hero' | 'medium' | 'closeup' | 'table' | 'ingredient';
  widths: number[];
  description: string;
  heart?: boolean;
}

/* Real, sourced dishes — see src/content/restaurants/*.json for provenance. */
const DISHES: Dish[] = [
  {
    slug: 'pizza-de-boletus',
    name: 'Pizza de boletus',
    where: 'En todas las casas',
    restaurantSlug: 'lamucca-de-pez',
    restaurantName: 'Lamucca de Pez',
    role: 'hero',
    widths: [640, 980, 1400],
    description:
      'La pizza que no se cambia. Nació en Lamucca de Pez, la primera casa, el 1 de mayo de 2008 — y desde entonces está en la carta de las dieciocho.',
    heart: true,
  },
  {
    slug: 'pan-pam',
    name: 'Pan «Pam!»',
    where: 'En Bruto',
    restaurantSlug: 'en-bruto',
    restaurantName: 'En Bruto · Salesas',
    role: 'medium',
    widths: [480, 720],
    description:
      'El pan artesano del obrador-laboratorio: masa madre y horneado propio, junto a un café que ganó el Madrid Roaster Competition 2023.',
  },
  {
    slug: 'casqueria-fina',
    name: 'Casquería fina',
    where: 'Ultramarines del Coso',
    restaurantSlug: 'ultramarines-trafalgar',
    restaurantName: 'Ultramarines del Coso · Trafalgar',
    role: 'closeup',
    widths: [480, 720],
    description:
      'La protagonista de la taberna: casquería fina con alma de barrio castizo, en una carta firmada por el chef ejecutivo Dani Álvarez Marthón.',
  },
  {
    slug: 'arroces',
    name: 'Arroces',
    where: 'La Pescadería',
    restaurantSlug: 'la-pescaderia',
    restaurantName: 'La Pescadería',
    role: 'table',
    widths: [640, 980, 1400],
    description:
      'Campo, mar, tierra y arroz: la carta que mezcla lo tradicional con lo trendy en la vieja pescadería de Ballesta, desde 2013.',
  },
  {
    slug: 'parrilla-organica',
    name: 'Parrilla orgánica',
    where: 'Organik ⚡ Parriya',
    restaurantSlug: 'lamucca-de-andes',
    restaurantName: 'Lamucca de Andes',
    role: 'ingredient',
    widths: [480, 720],
    description:
      'Producto ecológico y de proximidad sobre brasas, en la primera casa del grupo fuera del centro: el espíritu Lamucca, con más cielo.',
  },
];

const fotos = import.meta.glob<{ default: ImageMetadata }>('../../assets/casas/*.jpg', {
  eager: true,
});
const fotoDe = (slug: string) => fotos[`../../assets/casas/${slug}.jpg`]?.default;

/* Roughly how much of the grid's width each role actually renders at on
   desktop (hero + table are multi-column; the rest are single-column) — so
   the browser never has to pick an undersized srcset candidate. */
const SIZES: Record<Dish['role'], string> = {
  hero: '(min-width: 900px) 48vw, 92vw',
  medium: '(min-width: 900px) 23vw, 92vw',
  closeup: '(min-width: 900px) 23vw, 92vw',
  ingredient: '(min-width: 900px) 23vw, 92vw',
  table: '(min-width: 900px) 72vw, 92vw',
};

/* The high-resolution plate: only fetched by the browser once a tile is
   actually opened (its <img src> is set by JS at that moment, not rendered
   into the page up front) — "load high-resolution image only when needed". */
const grandes = Object.fromEntries(
  await Promise.all(
    DISHES.map(async (d) => {
      const foto = fotoDe(d.restaurantSlug);
      if (!foto) return [d.slug, null];
      const [avif, webp, jpg] = await Promise.all([
        getImage({ src: foto, width: 1400, format: 'avif' }),
        getImage({ src: foto, width: 1400, format: 'webp' }),
        getImage({ src: foto, width: 1400, format: 'jpeg' }),
      ]);
      return [d.slug, { avif: avif.src, webp: webp.src, jpg: jpg.src, width: jpg.attributes.width, height: jpg.attributes.height }];
    })
  )
);

const base = import.meta.env.BASE_URL;

const dishesForClient = DISHES.map((d) => ({
  slug: d.slug,
  name: d.name,
  where: d.where,
  restaurantSlug: d.restaurantSlug,
  restaurantName: d.restaurantName,
  description: d.description,
  grande: grandes[d.slug],
}));
---

<section class="comida" id="comida" aria-labelledby="comida-title">
  <div class="container">
    <header class="capitulo-head" data-reveal>
      <p class="capitulo-num label">Capítulo 06 — La comida</p>
      <h2 class="capitulo-title" id="comida-title">Ven con hambre.</h2>
      <p class="capitulo-sub">
        <em class="voice">Lo demás lo ponemos nosotros.</em>&#32;La cocina no cierra. Ni si eres
        grande o pequeño, vegano o carnívoro. Pizza, solomillo y tataki en la misma página:
        nos dijeron que era una locura y llevamos así desde 2008.
      </p>
    </header>
  </div>

  <!-- La cadena de verbos — their own words, made enormous -->
  <ol class="verbos">
    {verbos.map((v, i) => (
      <li class="verbo" data-verb-edition={v.edition} data-reveal style={`--reveal-delay: ${(i % 4) * 60}ms`}>
        <span class="verbo__word">{v.verb}</span>
        <span class="verbo__what">{v.what}</span>
      </li>
    ))}
  </ol>

  <div class="container">
    <!-- El manifiesto — HIGH LOW, in their own words -->
    <div class="manifiesto" data-reveal>
      <p class="manifiesto__high">
        <span class="label manifiesto__side">High</span>
        Alta calidad de producto, ambiente muy cuidado, excelentes localizaciones.
      </p>
      <p class="manifiesto__low">
        <span class="label manifiesto__side manifiesto__side--accent">Low</span>
        Precio justo, cero ceremonia y la mejor materia prima que encontremos.
      </p>
    </div>

    <p class="manifiesto__claim" data-reveal style="--reveal-delay: 160ms">
      Apostamos por<br /><em class="voice">lo auténtico.</em>
    </p>

    <!-- La galería — cinco firmas, cinco formas -->
    <p class="label galeria__head" data-reveal>Lo que hay que probar</p>
    <div class="galeria" data-galeria>
      {DISHES.map((d, i) => {
        const foto = fotoDe(d.restaurantSlug);
        const dishJson = JSON.stringify(dishesForClient[i]);
        return (
          <button
            type="button"
            class={`dish dish--${d.role}`}
            data-dish={dishJson}
            data-reveal="rise"
            style={`--reveal-delay: ${(i % 3) * 90}ms`}
            aria-haspopup="dialog"
          >
            <span class="dish__media">
              {foto && (
                <Picture
                  src={foto}
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  widths={d.widths}
                  sizes={SIZES[d.role]}
                  alt={`Sala de ${d.restaurantName}`}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </span>
            <span class="dish__caption">
              <span class="dish__name">
                {d.heart && <span class="dish__heart" aria-hidden="true">♥</span>}
                {d.name}
              </span>
              <span class="dish__where label">{d.where}</span>
            </span>
          </button>
        );
      })}
    </div>
  </div>
</section>

<!-- El descubridor — the discovery panel. One persistent node; a tile click
     fills it and reveals it, so the dish's high-res plate is only requested
     the moment someone actually asks to see it. -->
<div class="descubridor" data-descubridor data-base={base} hidden>
  <div class="descubridor__backdrop" data-descubridor-cerrar></div>
  <div
    class="descubridor__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="descubridor-nombre"
  >
    <button class="descubridor__cerrar" type="button" data-descubridor-cerrar aria-label="Cerrar">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12" />
      </svg>
    </button>

    <div class="descubridor__media campo">
      <img data-descubridor-img alt="" decoding="async" loading="lazy" />
    </div>

    <div class="descubridor__body">
      <p class="descubridor__where label" data-descubridor-where></p>
      <h3 class="descubridor__nombre" id="descubridor-nombre" data-descubridor-nombre></h3>
      <p class="descubridor__desc" data-descubridor-desc></p>

      <dl class="descubridor__precio">
        <dt class="label">Precio</dt>
        <dd data-descubridor-precio>Precio justo. Sin lista pública — se consulta en sala.</dd>
      </dl>

      <div class="descubridor__ctas">
        <a class="btn" data-descubridor-menu href={`${base}#casas`}>Ver menú</a>
        <a class="btn btn--stamp" href={`${base}#descubre`}>Encontrar restaurante</a>
      </div>
    </div>
  </div>
</div>

<script>
  /* Vanilla, no library. One shared panel; tiles only ever hand it data. */
  const galeria = document.querySelector<HTMLElement>('[data-galeria]');
  const descubridor = document.querySelector<HTMLElement>('[data-descubridor]');

  if (galeria && descubridor) {
    const backdropAndClose = Array.from(
      descubridor.querySelectorAll<HTMLElement>('[data-descubridor-cerrar]')
    );
    const img = descubridor.querySelector<HTMLImageElement>('[data-descubridor-img]')!;
    const whereEl = descubridor.querySelector<HTMLElement>('[data-descubridor-where]')!;
    const nombreEl = descubridor.querySelector<HTMLElement>('[data-descubridor-nombre]')!;
    const descEl = descubridor.querySelector<HTMLElement>('[data-descubridor-desc]')!;
    const menuLink = descubridor.querySelector<HTMLAnchorElement>('[data-descubridor-menu]')!;
    const base = descubridor.dataset.base ?? '/';

    let lastTrigger: HTMLElement | null = null;

    function abrir(tile: HTMLElement) {
      const data = tile.dataset.dish;
      if (!data) return;
      const dish = JSON.parse(data);

      whereEl.textContent = dish.where;
      nombreEl.textContent = dish.name;
      descEl.textContent = dish.description;
      menuLink.href = `${base}restaurantes/${dish.restaurantSlug}/`;

      if (dish.grande) {
        img.src = dish.grande.jpg;
        img.srcset = `${dish.grande.avif} 1x`;
        img.width = dish.grande.width;
        img.height = dish.grande.height;
      }
      img.alt = `Sala de ${dish.restaurantName}`;

      lastTrigger = tile;
      descubridor.hidden = false;
      requestAnimationFrame(() => descubridor.classList.add('is-open'));
      document.body.style.overflow = 'hidden';
      descubridor.querySelector<HTMLElement>('[data-descubridor-cerrar]')?.focus();
    }

    function cerrar() {
      descubridor.classList.remove('is-open');
      document.body.style.overflow = '';
      lastTrigger?.focus();
      window.setTimeout(() => {
        if (!descubridor.classList.contains('is-open')) descubridor.hidden = true;
      }, 260);
    }

    galeria.querySelectorAll<HTMLButtonElement>('[data-dish]').forEach((tile) => {
      tile.addEventListener('click', () => abrir(tile));
    });

    backdropAndClose.forEach((el) => el.addEventListener('click', cerrar));

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !descubridor.hidden) cerrar();
    });
  }
</script>

<style>
  .comida {
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  /* --- Los verbos --- */
  .verbos {
    list-style: none;
    margin: 0 0 var(--space-2xl);
    padding: 0;
    border-top: var(--rule);
  }

  .verbo {
    display: grid;
    gap: var(--space-2xs);
    padding: var(--space-m) var(--gutter);
    border-bottom: var(--rule);
    transition: background var(--t-micro) var(--ease-out);
  }

  .verbo__word {
    font-family: var(--font-display);
    font-size: var(--step-4);
    font-weight: var(--weight-display);
    line-height: 1;
    letter-spacing: var(--track-title);
    color: var(--text-primary);
  }

  .verbo__what {
    font-size: var(--step-0);
    color: var(--text-tertiary);
    max-width: 46ch;
  }

  /* The verb belonging to the current Madrid daypart */
  .verbo[data-verb-now='true'] {
    background: var(--surface-raised);
  }

  .verbo[data-verb-now='true'] .verbo__word {
    color: var(--text-accent);
    font-style: italic;
  }

  .verbo[data-verb-now='true'] .verbo__what {
    color: var(--text-secondary);
  }

  .verbo[data-verb-now='true'] .verbo__word::after {
    content: ' — ahora';
    font-family: var(--font-text);
    font-style: normal;
    font-size: var(--step--1);
    font-weight: var(--weight-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    vertical-align: middle;
    margin-left: 0.6em;
  }

  /* --- El manifiesto --- */
  .manifiesto {
    display: grid;
    gap: var(--space-l);
    margin-block: var(--space-2xl) var(--space-xl);
  }

  .manifiesto__high,
  .manifiesto__low {
    display: grid;
    gap: var(--space-xs);
    font-size: var(--step-2);
    line-height: 1.25;
    max-width: 26ch;
  }

  .manifiesto__high {
    font-family: var(--font-display);
    font-weight: 480;
  }

  .manifiesto__low {
    font-family: var(--font-text);
    font-weight: var(--weight-semi);
    justify-self: end;
    text-align: right;
  }

  .manifiesto__side {
    color: var(--text-tertiary);
    font-size: var(--step-0);
  }

  .manifiesto__side--accent {
    color: var(--text-accent);
  }

  .manifiesto__claim {
    font-family: var(--font-display);
    font-size: var(--step-5);
    font-weight: var(--weight-display);
    line-height: var(--leading-hero);
    letter-spacing: var(--track-title);
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .manifiesto__claim em {
    color: var(--tomato);
  }

  /* =========================================================================
     LA GALERÍA — asymmetric editorial grid
     ========================================================================= */
  .galeria__head {
    color: var(--text-tertiary);
    margin-bottom: var(--space-m);
  }

  .galeria {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-m);
  }

  .dish {
    display: grid;
    text-align: left;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    color: inherit;
    cursor: pointer;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: var(--rule);
  }

  .dish__media {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    background: var(--surface-raised);
  }

  .dish__media :global(picture),
  .dish__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .dish__media :global(img) {
    object-fit: cover;
    filter: none;
    transition: transform 400ms var(--ease-out);
  }

  .dish--hero .dish__media { aspect-ratio: 4 / 3; }
  .dish--medium .dish__media { aspect-ratio: 1 / 1; }
  .dish--closeup .dish__media { aspect-ratio: 3 / 4; }
  .dish--table .dish__media { aspect-ratio: 16 / 9; }
  .dish--ingredient .dish__media { aspect-ratio: 1 / 1; }

  .dish__caption {
    position: absolute;
    inset: auto 0 0 0;
    z-index: 1;
    display: grid;
    gap: 2px;
    padding: var(--space-s) var(--space-m);
    background: linear-gradient(180deg, rgb(32 27 22 / 0) 0%, rgb(32 27 22 / 0.82) 78%);
    transition: opacity var(--t-enter) var(--ease-out), transform var(--t-enter) var(--ease-out);
  }

  .dish__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 540;
    color: var(--paper);
  }

  .dish__heart {
    color: var(--coral);
    margin-right: 0.35em;
  }

  .dish__where {
    color: rgb(244 238 227 / 0.78);
  }

  /* Touch/no-hover: the caption is always readable, tap opens the panel */
  @media (hover: none) {
    .dish__media { position: relative; }
    .dish__caption { position: absolute; opacity: 1; transform: none; }
  }

  /* Pointer + hover: caption stays subtle until you ask for it */
  @media (hover: hover) {
    .dish__caption {
      opacity: 0;
      transform: translateY(8px);
    }

    .dish:hover .dish__caption,
    .dish:focus-visible .dish__caption {
      opacity: 1;
      transform: none;
    }

    .dish:hover .dish__media :global(img),
    .dish:focus-visible .dish__media :global(img) {
      transform: scale(1.03);
    }
  }

  .dish:focus-visible {
    outline: var(--focus-ring);
    outline-offset: 2px;
  }

  @media (min-width: 700px) {
    .galeria {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-rows: clamp(140px, 16vw, 210px);
      gap: var(--space-l);
    }

    .dish { border-radius: var(--radius-card); }
    .dish__media { height: 100%; }
    .dish--hero .dish__media,
    .dish--medium .dish__media,
    .dish--closeup .dish__media,
    .dish--table .dish__media,
    .dish--ingredient .dish__media {
      aspect-ratio: auto;
    }

    .dish--hero { grid-area: hero; }
    .dish--medium { grid-area: medium; }
    .dish--closeup { grid-area: closeup; }
    .dish--ingredient { grid-area: ingredient; }
    .dish--table { grid-area: table; }

    .galeria {
      grid-template-areas:
        'hero hero medium closeup'
        'hero hero ingredient closeup'
        'table table table closeup';
    }
  }

  /* =========================================================================
     EL DESCUBRIDOR — the discovery panel
     ========================================================================= */
  .descubridor {
    position: fixed;
    inset: 0;
    z-index: var(--z-sheet);
    display: grid;
    place-items: center;
    padding: var(--space-m);
  }

  .descubridor[hidden] {
    display: none;
  }

  .descubridor__backdrop {
    position: fixed;
    inset: 0;
    background: rgb(32 27 22 / 0.5);
    backdrop-filter: blur(6px);
    opacity: 0;
    transition: opacity var(--t-enter) var(--ease-out);
  }

  .descubridor.is-open .descubridor__backdrop {
    opacity: 1;
  }

  .descubridor__panel {
    position: relative;
    width: min(36rem, 100%);
    max-height: min(88vh, 44rem);
    overflow-y: auto;
    background: var(--surface-page);
    border: var(--rule);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-print);
    opacity: 0;
    transform: translateY(16px) scale(0.98);
    transition: opacity var(--t-enter) var(--ease-out), transform var(--t-enter) var(--ease-snap);
  }

  .descubridor.is-open .descubridor__panel {
    opacity: 1;
    transform: none;
  }

  .descubridor__cerrar {
    position: absolute;
    top: var(--space-s);
    right: var(--space-s);
    z-index: 2;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: var(--rule-width) solid var(--paper);
    background: rgb(32 27 22 / 0.55);
    color: var(--paper);
    cursor: pointer;
  }

  .descubridor__media {
    --campo-ratio: 4 / 3;
  }

  .descubridor__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: none;
  }

  .descubridor__body {
    padding: var(--space-l);
    display: grid;
    gap: var(--space-2xs);
  }

  .descubridor__where {
    color: var(--text-accent);
  }

  .descubridor__nombre {
    font-size: var(--step-3);
  }

  .descubridor__desc {
    margin-top: var(--space-xs);
    color: var(--text-secondary);
  }

  .descubridor__precio {
    margin-top: var(--space-m);
    padding-top: var(--space-m);
    border-top: var(--hairline);
    display: grid;
    gap: 2px;
  }

  .descubridor__precio dt {
    color: var(--text-tertiary);
  }

  .descubridor__precio dd {
    margin: 0;
    color: var(--text-secondary);
  }

  .descubridor__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-s);
    margin-top: var(--space-l);
  }

  @media (min-width: 700px) {
    .verbo {
      grid-template-columns: 1fr 1fr;
      align-items: baseline;
      gap: var(--space-l);
