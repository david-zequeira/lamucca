---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Teletipo from '../components/Teletipo.astro';
import Ch01Hero from '../components/home/Ch01Hero.astro';
import Ch02Mundo from '../components/home/Ch02Mundo.astro';
import Ch03Madrid from '../components/home/Ch03Madrid.astro';
import Ch04MadridMapa from '../components/home/Ch04MadridMapa.astro';
import Ch05Descubre from '../components/home/Ch05Descubre.astro';
import Ch06Comida from '../components/home/Ch06Comida.astro';
import Ch07Muckeros from '../components/home/Ch07Muckeros.astro';
import Ch08Reserva from '../components/home/Ch08Reserva.astro';

/* The eight chapters — see docs/strategy/information-architecture.md Part III.
   Arrival → world → city → map → choice → food → people → invitation. */
---

<Base
  title="Lamucca — Restaurantes en Madrid desde 2008"
  description="Dieciocho casas por Madrid con la cocina abierta todo el día. Alta calidad de producto, ambiente cuidado y precio justo: High Low, desde 2008. Reserva tu mesa."
  preloadHero
>
  <Nav />

  <main id="main">
    <Ch01Hero />

    <Teletipo
      items={[
        'Madrid',
        'Desde 2008',
        'High Low',
        'Pizza de boletus',
        'Cocina abierta todo el día',
        'Muckeros',
        'Buen rollo',
      ]}
    />

    <Ch02Mundo />
    <Ch03Madrid />
    <Ch04MadridMapa />
    <Ch05Descubre />
    <Ch06Comida />

    <Teletipo
      items={[
        'La Pescadería',
        'Ultramarines del Coso',
        'En Bruto',
        'Club Fishermans',
        'Makáá',
        'Kiosco Magadán',
        'Lamucca del Mar',
      ]}
    />

    <Ch07Muckeros />
    <Ch08Reserva />
  </main>

  <Footer />
</Base>
